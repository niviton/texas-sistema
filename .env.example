# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo ".env" NUNCA deve ser commitado (já está no .gitignore).

# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-gerada
DJANGO_DEBUG=True
# Domínios aceitos em produção, separados por vírgula (vazio + DEBUG=True aceita qualquer um)
DJANGO_ALLOWED_HOSTS=

# Microsoft Entra ID / Graph API (SharePoint - Sites.Selected)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Site do SharePoint (O.T.BRASIL)
# Formato do hostname: suaempresa.sharepoint.com
# Formato do site path: /sites/NomeDoSite
MS_SHAREPOINT_HOSTNAME=
MS_SHAREPOINT_SITE_PATH=
# Preenchido automaticamente/uma vez que você descobrir o Site ID (opcional, evita nova chamada toda vez)
MS_SHAREPOINT_SITE_ID=

# Forma mais simples/confiável: cole aqui o link de compartilhamento do
# SharePoint (o mesmo que aparece na barra de endereço ao abrir o arquivo/pasta).
# Se preenchido, tem prioridade sobre o caminho manual abaixo.
MS_EXCEL_SHARE_URL=
MS_CERTIFICATES_FOLDER_SHARE_URL=

# Alternativa: caminho manual (dentro da biblioteca de documentos do site) da
# planilha de controle de certificados, ex: "Controle/Certificados.xlsx"
MS_EXCEL_ITEM_PATH=

# Alternativa: caminho manual da pasta onde ficam os arquivos de certificado
# (PDFs), ex: "Certificados"
MS_CERTIFICATES_FOLDER_PATH=

# Nome da coluna no Excel que tem o código do certificado (para casar cada
# linha com o arquivo certo). Padrão: "Código"
MS_EXCEL_CODE_COLUMN=Código

# Nome da coluna onde o link exato será escrito (criada automaticamente se
# não existir). Padrão: "Link"
MS_EXCEL_LINK_COLUMN=Link

# E-mail (Gmail). Gere uma "senha de app" em https://myaccount.google.com/apppasswords
# (exige verificação em 2 etapas ativa na conta). Não use a senha normal do Gmail.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Endereço do sistema, usado nos links dos e-mails
SITE_URL=http://127.0.0.1:8000
